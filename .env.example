# Copy to .env and fill in. Never commit .env.
# Defaults point at the local Docker Postgres from `just db-up`; the passwords
# are fixed development values that only work against that container.

# ---------- Database ----------
# The API connects as the application role (30-second timeouts).
DATABASE_URL=postgresql+psycopg://socius_app:socius_app_local@localhost:5432/socius
# `just migrate` connects as the migration role (no timeouts, owns the schema).
MIGRATION_DATABASE_URL=postgresql+psycopg://socius_migrate:socius_migrate_local@localhost:5432/socius
# Connection pool size per API process.
DB_POOL_SIZE=5

# ---------- Auth (Supabase, ADR-0004) ----------
# Project URL, e.g. https://<project>.supabase.co
SUPABASE_URL=
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# <SUPABASE_URL>/auth/v1
SUPABASE_JWT_ISSUER=
# Expected `aud` claim on access tokens.
SUPABASE_JWT_AUDIENCE=authenticated

# ---------- Monitoring ----------
# Sentry project DSN; empty disables error reporting.
SENTRY_DSN=
# Heartbeat URL pinged after each successful close-job run; empty disables it.
CRON_HEARTBEAT_URL=
# The monitor's failure URL, pinged when a close-job run fails.
CRON_HEARTBEAT_FAIL_URL=

# ---------- Push ----------
# Only needed if Expo's enhanced push security is turned on.
EXPO_ACCESS_TOKEN=

# ---------- Jobs ----------
# Runs the in-process close job; set to false in tests.
SCHEDULER_ENABLED=true

# ---------- Environment ----------
# One of: local, test, staging, production.
APP_ENV=local
# ISO timestamp that replaces the clock, staging only. Startup fails if set in production.
FAKE_NOW=

# ---------- Mobile app (public, bundled into the app) ----------
# Base URL of the API, as reachable from the phone.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Same value as SUPABASE_URL.
EXPO_PUBLIC_SUPABASE_URL=
# Supabase anon key; public by design, access is enforced by the API.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
